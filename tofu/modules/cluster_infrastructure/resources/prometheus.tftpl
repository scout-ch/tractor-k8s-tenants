---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: infrastructure-prometheus
  namespace: flux-system
spec:
  interval: 10m
  retryInterval: 1m
  sourceRef:
    kind: GitRepository
    name: flux-system
  serviceAccountName: kustomize-controller
  path: ./infrastructure/prometheus
  prune: true
  wait: true
  %{~ if length(patches) > 0 ~}
  patches:
    - target:
        kind: "HelmRelease"
        name: "prometheus"
      patch: ${ indent(6, yamlencode(patches)) }
  %{~ endif ~}
